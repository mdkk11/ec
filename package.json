{
  "name": "mockshop-storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build-storybook": "storybook build",
    "ci:impact:select": "node scripts/impact/select-affected-e2e.mjs",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:prepare:e2e": "NODE_ENV=test tsx scripts/db/prepare-e2e.ts",
    "db:prepare:test": "NODE_ENV=test tsx scripts/db/prepare-test.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:up": "docker compose up -d --wait postgres-dev postgres-test postgres-e2e",
    "dev": "next dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "knip": "DATABASE_URL=postgresql://mockshop:mockshop_local@localhost:5432/mockshop_dev E2E_DATABASE_URL=postgresql://mockshop:mockshop_local@localhost:5432/mockshop_e2e knip",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint-gap",
    "lint:eslint-gap": "eslint .storybook src",
    "lint:fix": "oxlint --fix .",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:parity": "node scripts/tooling/verify-lint-parity.mjs",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:serve": "http-server storybook-static -a 127.0.0.1 -p 6006 -c-1 --silent",
    "test:backend": "vitest run --project backend",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:selected": "NODE_ENV=test node scripts/impact/run-selected-e2e.mjs",
    "test:frontend": "vitest run --project frontend",
    "test:unit": "vitest run --project unit",
    "test:vrt": "storybook build && playwright test --config=playwright.vrt.config.ts",
    "test:vrt:update": "storybook build && playwright test --config=playwright.vrt.config.ts --update-snapshots",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-query": "5.101.4",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/nextjs-vite": "10.5.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.4.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.67.0",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-storybook": "10.5.3",
    "http-server": "14.1.1",
    "jsdom": "29.1.1",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "msw": "2.15.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "storybook": "10.5.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.23.0"
}
