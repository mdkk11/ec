{
  "name": "mockshop-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:selected": "NODE_ENV=test node scripts/impact/run-selected-e2e.mjs",
    "test:vrt": "storybook build && playwright test --config=playwright.vrt.config.ts",
    "test:vrt:update": "storybook build && playwright test --config=playwright.vrt.config.ts --update-snapshots",
    "db:up": "docker compose up -d --wait postgres-dev postgres-test postgres-e2e",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:prepare:test": "NODE_ENV=test tsx scripts/db/prepare-test.ts",
    "db:prepare:e2e": "NODE_ENV=test tsx scripts/db/prepare-e2e.ts",
    "ci:impact:select": "node scripts/impact/select-affected-e2e.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-query": "5.101.4",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-storybook": "10.5.10",
    "http-server": "14.1.1",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
